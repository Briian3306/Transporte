+    filasVigentes: count((r) => r.codigo === 'CURRENT_TARIFF'),
+    filasHistoricas: count((r) => r.codigo === 'HISTORICAL_TARIFF_MATCH'),
+    filasCorreccionCategoria: count((r) => CODIGOS_CORRECCION.has(r.codigo)),
