+  assert.equal(hole.ESTADO_MATCH, 'SIN_TARIFA');
+  assert.equal(hole.MOTIVO, 'SIN_TARIFA');
+  assert.equal(hole.PRECIO, '');
+  assert.equal(hole.TARIFA_ID, '');
+  assert.equal(hole.LAST_UPDATED, '');
