+  const { cruzado } = buildInformeTarifario(last, tarifas, importes);
+  const missing = filasSinPrecio(cruzado);
+  assert.ok(missing.some((r) => r.ESTACION === 'TIGRE' && r.PEAJE === 'AUSOL' && String(r.CATEGORIA) === '2'));
