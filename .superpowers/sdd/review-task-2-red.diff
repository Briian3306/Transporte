+CREATE FUNCTION pg_temp.pasadas_sentido(p_id uuid)
+RETURNS text
+LANGUAGE plpgsql AS $$
+DECLARE
+  v text;
+BEGIN
+  EXECUTE format(
+    'SELECT sentido::text FROM public.pasadas WHERE id = %L',
+    p_id
+  ) INTO v;
+  RETURN v;
+EXCEPTION
+  WHEN undefined_column THEN
+    RETURN NULL;
+END;
+$$;
+
