            margin: 0 auto;
            margin-bottom: 10px;
            font-size: 18px;
            letter-spacing: 0.5px;
        }
    </style>

    <script>
        $(document).ready(function () {
            $('#btnMostrarPassword').on('click', function () {
                var passwordInput = document.getElementById("pbPassword");
                if (passwordInput.type == "password") {
                    // Muestra la contraseña
                    passwordInput.type = "text";
                    $('#eyeIcon').removeClass('fa fa-eye').addClass('fa fa-eye-slash');
                } else {
                    // Oculta la contraseña
                    passwordInput.type = "password";
                    $('#eyeIcon').removeClass('fa fa-eye-slash').addClass('fa fa-eye');
                }
            });
        });
    </script>
</body>
</html>



<!-- Modal Bootstrap 3.3.7 -->
<div class="modal fade" id="sessionWarningModal" tabindex="-1" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" style="max-width:500px;">
        <div class="modal-content">
            <div class="modal-header" style="background-color:#036350; color:white;">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Sesión por expirar</h4>
            </div>
            <div class="modal-body">
                <p>Tu sesión está por expirar. ¿Deseás continuar?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="continueSessionBtn">Continuar</button>
            </div>
        </div>
    </div>
</div>




<script>
  // ---- Config inyectada ----
  const EFFECTIVE_TIMEOUT_MIN = 10;
  const WARNING_LEAD_MIN      = 2;
  const LOGIN_URL             = '/Login/';
  const KEEP_ALIVE_URL        = '/Login/Home/KeepSessionAlive';

  let warningTimer = 0, logoutTimer = 0, heartbeatId = 0;
  let lastPing = 0, loggedOut = false;

  // Detectar si estoy EXACTAMENTE en la acción de login (no por "includes")
  function isOnLoginPage() {
    const loginPath = new URL(LOGIN_URL, window.location.origin).pathname.toLowerCase();
    return window.location.pathname.toLowerCase() === loginPath;
  }

  // --- KeepAlive AJAX ---
  function pingKeepAlive(cb){
    $.ajax({
      url: KEEP_ALIVE_URL + (KEEP_ALIVE_URL.indexOf('?')>=0?'&':'?') + '_=' + Date.now(),
      type: 'POST',
      cache: false,
      success: function(data){
        if (cb) cb(!!(data && data.success), data);
      },
      error: function(){ if (cb) cb(false); }
    });
  }

  function clearTimers(){
    if (warningTimer) { clearTimeout(warningTimer); warningTimer = 0; }
    if (logoutTimer)  { clearTimeout(logoutTimer);  logoutTimer  = 0; }
  }

  function startSessionTimers(){
    clearTimers();
    const warnMs   = Math.max(0, (EFFECTIVE_TIMEOUT_MIN - WARNING_LEAD_MIN) * 60000);
    const logoutMs = Math.max(0, EFFECTIVE_TIMEOUT_MIN * 60000);

    warningTimer = setTimeout(showWarningModal, warnMs);
    logoutTimer  = setTimeout(() => {
      loggedOut = true;
      if (!isOnLoginPage()) window.location.href = LOGIN_URL;
    }, logoutMs);
  }

  function resetSessionTimers(){ startSessionTimers(); }

  function showWarningModal(){
    if (loggedOut || isOnLoginPage()) return;
    if (typeof $('#sessionWarningModal').modal === 'function') {
      $('#sessionWarningModal').modal('show');
    } else {
      $('#sessionWarningModal').show(); // fallback si no está Bootstrap JS
    }
    // Si no confirma, lo echamos en WARNING_LEAD_MIN minutos
    setTimeout(() => {
      if (!loggedOut) window.location.href = LOGIN_URL;
    }, WARNING_LEAD_MIN * 60000);
  }

// Botón "Continuar" (event delegation por si el modal se re-renderiza)
$(document).on('click', '#continueSessionBtn', function (e) {
  e.preventDefault();

  $.ajax({
    url: '/Login/Home/KeepSessionAlive' + '?_=' + Date.now(), // anti-cache
    type: 'POST',
    cache: false,
    dataType: 'json' // <- importante para que "data" sea objeto, no string
  })
  .done(function (data) {
    if (data && data.success) {
      // Sesión renovada
      if (typeof $('#sessionWarningModal').modal === 'function') {
        $('#sessionWarningModal').modal('hide');
      } else {
        $('#sessionWarningModal').hide();
      }
      resetSessionTimers();
    } else if (data && data.expired) {
      // Ya estaba vencida
      window.location.href = (data.redirect || '/Login/');
    } else {
      // Respuesta inesperada
      console.warn('[KeepAlive] Respuesta sin success/expired', data);
      window.location.href = '/Login/';
    }
  })
  .fail(function (xhr) {
    // Si por algún motivo falló, mejor redirigir a login
    console.error('[KeepAlive] AJAX fail', xhr.status, xhr.statusText);
    window.location.href = '/Login/';
  });
});

  // Throttle (máx. 1 ping/min)
  function pingThrottle(){
    const now = Date.now();
    if (now - lastPing > 60000){
      lastPing = now;
      pingKeepAlive();
    }
  }

  // 🔑 Si hay actividad con el modal abierto: PING INMEDIATO
  function onActivity(){
    const visible = $('#sessionWarningModal').is(':visible');
    if (visible){
      pingKeepAlive(function(){
        if (typeof $('#sessionWarningModal').modal === 'function') {
          $('#sessionWarningModal').modal('hide');
        } else {
          $('#sessionWarningModal').hide();
        }
        resetSessionTimers();
      });
    } else {
      pingThrottle();
      resetSessionTimers();
    }
  }

  // Heartbeat cada 60s mientras la pestaña está visible
  function startHeartbeat(){
    if (heartbeatId) clearInterval(heartbeatId);
    heartbeatId = setInterval(function(){
      if (!document.hidden) pingThrottle();
    }, 60000);
  }
  document.addEventListener('visibilitychange', function(){
    if (!document.hidden) pingThrottle();
  }, false);

  // Inicio
  $(function(){
    if (!isOnLoginPage()){
      startSessionTimers();
      startHeartbeat();
    }
  });

  // Actividad
  $(document).on('mousemove keydown click', onActivity);
</script>
