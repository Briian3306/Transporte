# Copy to the file for your mode and fill in real values:
#   .env.development  → pnpm start / ng serve (DESARROLLO remote)
#   .env.local        → pnpm dev / pnpm dev:app (Supabase CLI)
#   .env.production   → pnpm build:prod / Netlify
#
# Never commit real secrets. Netlify can set the same NG_APP_* names in Site settings.

NG_APP_SUPABASE_URL=https://your-project-id.supabase.co
NG_APP_SUPABASE_KEY=your-supabase-anon-key
NG_APP_API_URL=https://demo.tpteibarra.ar
NG_APP_AUTH_TOKEN=Token your-api-token
