# Copy to the file for your mode and fill in real values:
#   .env.development  → pnpm start (Angular + Netlify functions local, DESARROLLO remote)
#   .env.local        → pnpm dev / pnpm dev:app (Supabase CLI)
#   .env.production   → pnpm build:prod / Netlify cloud
#
# Never commit real secrets. Netlify can set the same NG_APP_* names in Site settings.
# pnpm start:app = Angular only (no functions).

NG_APP_SUPABASE_URL=https://your-project-id.supabase.co
NG_APP_SUPABASE_KEY=your-supabase-anon-key
NG_APP_API_URL=https://demo.tpteibarra.ar
NG_APP_AUTH_TOKEN=Token your-api-token

# OpenRouter from the Angular bundle (invoice AI). Keys are visible in the browser JS.
# Optional: the app starts without them; invoice suggestions stay manual.
NG_APP_OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
NG_APP_OPENROUTER_MODEL=
NG_APP_OPENROUTER_MODEL_2=
NG_APP_OPENROUTER_API_KEY=
NG_APP_OPENROUTER_API_KEY_2=
