{
  "name": "ibarra-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "env:sync": "node scripts/sync-env.mjs",
    "start": "node scripts/sync-env.mjs development && node scripts/start-netlify-dev.mjs",
    "start:app": "node scripts/sync-env.mjs development && ng serve",
    "dev": "npx supabase start && npm run dev:app",
    "dev:app": "node scripts/sync-env.mjs local && ng serve --configuration=local",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "seed:local": "node scripts/seed-local.mjs",
    "build": "node scripts/sync-env.mjs development && ng build",
    "build:prod": "node scripts/sync-env.mjs production && ng build --configuration production",
    "watch": "node scripts/sync-env.mjs development && ng build --watch --configuration development",
    "test": "node scripts/sync-env.mjs development && ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.0",
    "@angular/common": "^19.2.17",
    "@angular/compiler": "^19.2.17",
    "@angular/core": "^19.2.17",
    "@angular/forms": "^19.2.17",
    "@angular/platform-browser": "^19.2.17",
    "@angular/platform-browser-dynamic": "^19.2.17",
    "@angular/router": "^19.2.17",
    "@angular/service-worker": "^19.2.17",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@supabase/supabase-js": "^2.74.0",
    "date-fns": "^4.1.0",
    "pdf-parse": "^2.4.5",
    "pdfmake": "^0.2.20",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.17",
    "@angular/cli": "^19.2.17",
    "@angular/compiler-cli": "^19.2.17",
    "@types/jasmine": "~5.1.0",
    "@types/pdfmake": "^0.2.12",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "netlify-cli": "^27.1.2",
    "supabase": "^2.110.0",
    "typescript": "~5.7.2"
  }
}
